{
  "manifest_version": 3,
  "name": "SL Companion",
  "version": "0.2.8",
  "description": "Keeps page content below the Safari-like toolbar at the top of a page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-sl-companion@izsakirobi",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "154.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["browserSettings"]
}
